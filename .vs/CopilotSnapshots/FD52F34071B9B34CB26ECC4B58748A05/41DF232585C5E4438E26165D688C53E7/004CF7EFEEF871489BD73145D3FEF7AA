        private void LoadProducts()
        {
            try
            {
                var products = _bl.Product.ReadAll();
                _currentList = products ?? new List<Product>();
                ApplyFiltersAndBind();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"שגיאה בטעינת מוצרים: {ex.Message}");
            }
        }

        private void ApplyFiltersAndBind()
        {
            IEnumerable<Product> filtered = _currentList;

            var search = textBoxSearch.Text?.Trim();
            if (!string.IsNullOrEmpty(search))
            {
                var s = search.ToLower();
                filtered = filtered.Where(p =>
                    (p.ToString() != null && p.ToString().ToLower().Contains(s)) ||
                    p.ProductId.ToString().Contains(s));
            }

            if (checkBoxInStockOnly.Checked)
            {
                filtered = filtered.Where(p => p.QuantityInStock > 0);
            }

            var list = filtered.ToList();
            dataGridViewProducts.DataSource = null;
            dataGridViewProducts.DataSource = list;

            // Friendly column names if available
            if (dataGridViewProducts.Columns["ProductId"] != null) dataGridViewProducts.Columns["ProductId"].HeaderText = "קוד מוצר";
            if (dataGridViewProducts.Columns["Name"] != null) dataGridViewProducts.Columns["Name"].HeaderText = "שם מוצר";
            if (dataGridViewProducts.Columns["QuantityInStock"] != null) dataGridViewProducts.Columns["QuantityInStock"].HeaderText = "כמות במלאי";
            if (dataGridViewProducts.Columns["Price"] != null) dataGridViewProducts.Columns["Price"].HeaderText = "מחיר";
            lblTotalCount.Text = $"סה\"כ מוצרים: {list.Count}";
        }

        private void TextBoxSearch_TextChanged(object sender, EventArgs e) => ApplyFiltersAndBind();
        private void FilterControls_Changed(object sender, EventArgs e) => ApplyFiltersAndBind();

        private void DataGridViewProducts_SelectionChanged(object sender, EventArgs e)
        {
            if (dataGridViewProducts.SelectedRows.Count > 0)
            {
                var row = dataGridViewProducts.SelectedRows[0].DataBoundItem as Product;
                if (row != null)
                {
                    txtName.Text = row.ToString() ?? string.Empty;
                    txtPrice.Text = row.Price.ToString() ?? string.Empty;
                    numQty.Value = Math.Min(numQty.Maximum, Math.Max(numQty.Minimum, row.QuantityInStock));
                    // set category selection
                    try { comboBoxCategory.SelectedItem = row.Category; } catch { }
                }
            }
        }

        private void DataGridViewProducts_CellDoubleClick(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex >= 0 && dataGridViewProducts.Rows[e.RowIndex].DataBoundItem is Product p)
            {
                MessageBox.Show(p.ToString(), "פרטי מוצר", MessageBoxButtons.OK);
            }
        }

        private void BtnAdd_Click(object sender, EventArgs e)
        {
            try
            {
                var price = ParseNullableDouble(txtPrice.Text);
                if (price == null)
                    throw new FormatException("הזן מספר תקין בשדה מחיר.");
                var prod = new Product
                {
                    //Name = txtName.Text.Trim(),
                    Price = price.Value,
                    QuantityInStock = (int)numQty.Value,
                    Category = comboBoxCategory.SelectedItem is Category c ? (BL.BO.Category)c : BL.BO.Category.SHIRT
                };

                var created = _bl.Product.Create(prod);
                MessageBox.Show("מוצר נוסף בהצלחה.", "אישור", MessageBoxButtons.OK, MessageBoxIcon.Information);
                LoadProducts();
                SelectCreatedOrUpdated(created);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"שגיאה בהוספה: {ex.Message}");
            }
        }

        private void BtnUpdate_Click(object sender, EventArgs e)
        {
            if (dataGridViewProducts.SelectedRows.Count == 0) { MessageBox.Show("בחר מוצר לעדכון."); return; }

            try
            {
                var selected = dataGridViewProducts.SelectedRows[0].DataBoundItem as Product;
                if (selected == null) return;

                var price = ParseNullableDouble(txtPrice.Text);
                if (price == null)
                    throw new FormatException("הזן מספר תקין בשדה מחיר.");


                //selected.Name = txtName.Text.Trim();
                selected.Price = price.Value;
                selected.QuantityInStock = (int)numQty.Value;
                selected.Category = comboBoxCategory.SelectedItem is Category c ? (BL.BO.Category)c : selected.Category;

                _bl.Product.Update(selected);
                MessageBox.Show("מוצר עודכן בהצלחה.", "אישור", MessageBoxButtons.OK, MessageBoxIcon.Information);
                LoadProducts();
                SelectCreatedOrUpdated(selected);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"שגיאה בעדכון: {ex.Message}");
            }
        }

        private void BtnDelete_Click(object sender, EventArgs e)
        {
            if (dataGridViewProducts.SelectedRows.Count == 0) { MessageBox.Show("בחר מוצר למחיקה."); return; }

            try
            {
                var selected = dataGridViewProducts.SelectedRows[0].DataBoundItem as Product;
                if (selected == null) return;

                var res = MessageBox.Show($"האם למחוק את המוצר {selected.ProductId}?", "מחיקה", MessageBoxButtons.YesNo, MessageBoxIcon.Warning); if (res == DialogResult.Yes)
                {
                    _bl.Product.Delete(selected.ProductId);
                    MessageBox.Show("נמחק בהצלחה.", "אישור", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    LoadProducts();
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"שגיאה במחיקה: {ex.Message}");
            }
        }

        private double? ParseNullableDouble(string s)
        {
            if (string.IsNullOrWhiteSpace(s)) return null;
            if (double.TryParse(s, out var v)) return v;
            throw new FormatException("הזן מספר תקין בשדה מחיר.");
        }

        // Helper to apply modern styling to buttons (font, size, padding, flat style, colors, hover effects)
        private void StyleModernButton(Button btn, Color baseColor)
        {
            if (btn == null) return;
            try
            {
                btn.Font = new Font(btn.Font.FontFamily, 12F, FontStyle.Bold);
                btn.Size = new Size(140, 50);
                btn.Padding = new Padding(8);
                btn.FlatStyle = FlatStyle.Flat;
                btn.FlatAppearance.BorderSize = 0;
                btn.BackColor = baseColor;
                btn.ForeColor = Color.White;
                btn.Cursor = Cursors.Hand;
                // subtle hover / pressed effects without changing logic
                btn.FlatAppearance.MouseOverBackColor = ControlPaint.Dark(baseColor, 0.06f);
                btn.FlatAppearance.MouseDownBackColor = ControlPaint.Dark(baseColor, 0.16f);
            }
            catch
            {
                // swallow styling exceptions to avoid affecting form logic
            }
        }

        private void SelectCreatedOrUpdated(Product item)
        {
            if (item == null) return;
            // try to find the product in the grid and select it
            foreach (DataGridViewRow row in dataGridViewProducts.Rows)
            {
                if (row.DataBoundItem is Product p && p.ProductId == item.ProductId)
                {
                    row.Selected = true;
                    dataGridViewProducts.FirstDisplayedScrollingRowIndex = row.Index;
                    break;
                }
            }
        }
    }
